# ============================================
# Synn - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/synn?sslmode=require

# ============================================
# Clerk Authentication
# ============================================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk Webhook Secret (for user sync)
# Get this from Clerk Dashboard > Webhooks > Endpoint > Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...

# ============================================
# Admin Configuration
# ============================================
# Comma-separated list of Clerk User IDs that have admin access
# Example: ADMIN_USER_IDS=user_2abc123,user_2def456
ADMIN_USER_IDS=

# ============================================
# Encryption (Optional - for Production)
# ============================================
# Path to RSA public key for encrypting sensitive data
# Private key should be kept secure and never committed
# Default: ./key/public.pem
# ENCRYPTION_PUBLIC_KEY_PATH=./key/public.pem

# ============================================
# Logging
# ============================================
# Log level: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# ============================================
# Performance Tuning (Optional)
# ============================================
# Batch size for commit processing during sync
# Default: 100
# COMMIT_BATCH_SIZE=100

# ============================================
# Development Only
# ============================================
# Set to 'development' to enable debug features
# NODE_ENV=development
